# ─── PartyVerse Backend Env Example ───
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/partyverse?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth / JWT
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRES=15m

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:4000/api/v1/auth/discord/callback

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Optional AI Narrator (OpenAI TTS)
OPENAI_API_KEY=
