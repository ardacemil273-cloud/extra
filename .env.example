# ─────────────────────────────────────────────────────────────
# PartyVerse — Env Example
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# ─── Frontend (Next.js) ───
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Backend (NestJS) ───
PORT=4000
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/partyverse?schema=public

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Auth / JWT ───
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRES=15m
REFRESH_TOKEN_SECRET=replace-with-another-random-secret

# Optional — Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Optional — Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:4000/api/v1/auth/discord/callback

# ─── Rate Limiting ───
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── AI Narrator — OpenAI TTS (optional) ───
OPENAI_API_KEY=
